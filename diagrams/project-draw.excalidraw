      "isDeleted": false,
      "boundElements": [],
      "updated": 1792086500953,
      "created": 1791664199151,
      "link": null,
      "locked": false,
      "text": "Qdrant was selected because\nsemantic retrieval is a core\ncapability of our application, our\nAI service is intentionally\nseparated from the main\nPostgreSQL-backed application,\nand our multi-tenant workload\nrequires metadata filtering on\nevery retrieval request\n\n",
      "fontSize": 44.969696969696926,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Qdrant was selected because semantic retrieval is a core capability of our application, our AI service is intentionally separated from the main PostgreSQL-backed application, and our multi-tenant workload requires metadata filtering on every retrieval request\n\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
