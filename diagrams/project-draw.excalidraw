      "text": "1. INGESTION & EXTRACTION",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. INGESTION & EXTRACTION",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "35b70f36d7a24fc48e958",
      "type": "text",
      "x": 1473.2,
      "y": -2060,
      "width": 770,
      "height": 500,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2QX",
      "roundness": null,
      "seed": 566061412,
      "version": 3,
      "versionNonce": 1093059345,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792086500954,
      "created": 1792085466651,
      "link": null,
      "locked": false,
      "text": "• 10-Page Onboarding Crawl (Scrapling Headless)\n• Marketing CSVs & Brand Asset Ingestion\n• External Social Mining (FB Ads Library, YouTube)\n• Scraped Content Sanitization & Data Quarantine\n• Knowledge Extractor analyzes completed tasks\n• Strict Governance: Individual candidate review\n  (strictly no uninspected bulk promotion)\n• Provenance-backed Audit Trail:\n  Source URL, freshness timestamp, version retirement",
      "fontSize": 18,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• 10-Page Onboarding Crawl (Scrapling Headless)\n• Marketing CSVs & Brand Asset Ingestion\n• External Social Mining (FB Ads Library, YouTube)\n• Scraped Content Sanitization & Data Quarantine\n• Knowledge Extractor analyzes completed tasks\n• Strict Governance: Individual candidate review\n  (strictly no uninspected bulk promotion)\n• Provenance-backed Audit Trail:\n  Source URL, freshness timestamp, version retirement",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
